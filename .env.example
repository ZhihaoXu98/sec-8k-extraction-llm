# Copy to .env locally; .env is gitignored.

# EDGAR — SEC requires a descriptive User-Agent header on every request.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# vLLM (OpenAI-compatible local server)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local

# Models
MODEL_BASE=Qwen/Qwen2.5-7B-Instruct
MODEL_ADAPTER_DIR=models/sft-latest
MODEL_AWQ_DIR=models/awq-int4

# Service
SEC8K_LOG_LEVEL=INFO
