# Copy to .env locally; .env is gitignored.

# EDGAR — SEC requires a descriptive User-Agent header on every request.
# Used by scripts/ingest_edgar.py.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Optional EDGAR ingester overrides:
#   SEC8K_DATA_DIR     — override the data root (default: ./data). The ingester
#                        writes to <SEC8K_DATA_DIR>/raw/edgar/ underneath.
#   SEC8K_HTTP_TIMEOUT — read timeout in seconds for SEC HTTP requests (default: 30.0).
#SEC8K_DATA_DIR=./data
#SEC8K_HTTP_TIMEOUT=30.0

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# vLLM (OpenAI-compatible local server)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local

# Models
MODEL_BASE=Qwen/Qwen2.5-7B-Instruct
MODEL_ADAPTER_DIR=models/sft-latest
MODEL_AWQ_DIR=models/awq-int4

# Service
SEC8K_LOG_LEVEL=INFO

# Claude API — used by scripts/llm_label_gold_set.py to build data/gold/v1.jsonl
ANTHROPIC_API_KEY=
# Optional Anthropic beta-header passthrough (e.g. extended caching). Leave unset for prod.
#ANTHROPIC_BETA=
